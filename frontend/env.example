# ============================================
# KAYAK FRONTEND - ENVIRONMENT CONFIGURATION  
# ============================================
# Copy this file to .env.local for local development
# 
# Note: Vite uses VITE_ prefix for client-side environment variables

# ============================================
# API CONFIGURATION
# ============================================
# Main API URL (leave empty to use Vite proxy in development)
VITE_API_URL=

# Admin Dashboard API (direct connection to Admin Service)
VITE_ADMIN_SERVICE_URL=http://localhost:8006

# Analytics API (direct connection to Analytics Service)
VITE_ANALYTICS_SERVICE_URL=http://localhost:8004

# AI Service (optional - for AI recommendations)
VITE_AI_SERVICE_URL=http://localhost:8005

# ============================================
# PRODUCTION EXAMPLE
# ============================================
# VITE_API_URL=https://api.kayak-clone.com
# VITE_ADMIN_SERVICE_URL=https://admin-api.kayak-clone.com
# VITE_ANALYTICS_SERVICE_URL=https://analytics-api.kayak-clone.com
# VITE_AI_SERVICE_URL=https://ai-api.kayak-clone.com

