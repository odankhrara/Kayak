# ============================================
# KAYAK SIMULATION - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and modify as needed
# 
# For local development with Docker:
#   - Copy this file: cp env.example .env
#   - Start Docker: docker-compose -f src/infra/docker-compose.yml up -d
#   - Start services: make start-backend
#
# For production, set these in your deployment environment

# ============================================
# DATABASE - MySQL
# ============================================
# Docker development (mapped to 3307 to avoid conflict with local MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=kayak

# Production example:
# MYSQL_HOST=your-mysql-host.com
# MYSQL_PORT=3306
# MYSQL_USER=kayak_user
# MYSQL_PASSWORD=<secure-password>
# MYSQL_DATABASE=kayak_prod

# ============================================
# DATABASE - MongoDB
# ============================================
MONGODB_URI=mongodb://localhost:27017/kayak
# or
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=kayak

# Production example:
# MONGODB_URI=mongodb://user:pass@your-mongo-host.com:27017/kayak?authSource=admin

# ============================================
# DATABASE - Redis (Caching)
# ============================================
REDIS_URL=redis://localhost:6379

# Production example:
# REDIS_URL=redis://:password@your-redis-host.com:6379

# ============================================
# MESSAGE QUEUE - Kafka
# ============================================
# For local development outside Docker:
KAFKA_BROKERS=localhost:29092

# Inside Docker containers:
# KAFKA_BROKERS=kafka:9092

# Production example:
# KAFKA_BROKERS=kafka1.example.com:9092,kafka2.example.com:9092

# ============================================
# AUTHENTICATION
# ============================================
# IMPORTANT: Change this in production!
JWT_SECRET=your-secret-key

# Production: Use a strong, unique secret
# JWT_SECRET=<generate-with: openssl rand -base64 64>

# ============================================
# SERVICE PORTS
# ============================================
# API Gateway (main entry point)
API_GATEWAY_PORT=4000

# Microservices (internal)
USER_SERVICE_PORT=8001
LISTING_SERVICE_PORT=8002
BOOKING_SERVICE_PORT=8003
ANALYTICS_SERVICE_PORT=8004
AI_SERVICE_PORT=8005
ADMIN_SERVICE_PORT=8006

# ============================================
# FRONTEND (Vite)
# ============================================
# API URL for frontend (empty = use Vite proxy to localhost:4000)
VITE_API_URL=

# Direct service URLs (for admin dashboard)
VITE_ADMIN_SERVICE_URL=http://localhost:8006
VITE_ANALYTICS_SERVICE_URL=http://localhost:8004

# AI Service (optional)
VITE_AI_SERVICE_URL=http://localhost:8005

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# QUICK START COMMANDS
# ============================================
# 1. Start infrastructure: docker-compose -f src/infra/docker-compose.yml up -d
# 2. Seed database: node src/db/seed-data.js
# 3. Start backend: make start-backend
# 4. Start frontend: cd frontend && npm run dev
# 5. Open: http://localhost:5173
#
# Default credentials:
# - Admin: admin@kayak.com / password123
# - Users: Check database or logs after seeding

