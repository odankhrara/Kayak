# AI Service Configuration
# Use Groq (preferred) - requires GROQ_API_KEY
USE_AI=true
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Fallback to Ollama (optional) - requires local Ollama installation
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database Configuration - MySQL (same as other services)
USE_MYSQL=true
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=kayak
# Alternative: Use DATABASE_URL directly
# DATABASE_URL=mysql+pymysql://root:password@localhost:3307/kayak
